generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("postgresql://smtp_user:e7sMJOPE9jJRDYcjA6LareEO1dseT8Hu@dpg-d9vst8lbedkc739c4edg-a/smtp_app")
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

model SmtpAccount {
  id          String   @id @default(cuid())
  name        String
  host        String
  port        Int
  username    String
  passwordEnc String
  secure      Boolean  @default(false)
  fromName    String?
  fromEmail   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    EmailMessage[]
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  html      String
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailMessage {
  id          String      @id @default(cuid())
  smtpId      String
  smtp        SmtpAccount @relation(fields: [smtpId], references: [id], onDelete: Cascade)
  to          String
  cc          String?
  bcc         String?
  subject     String
  html        String?
  text        String?
  status      EmailStatus @default(QUEUED)
  error       String?
  messageId   String?
  attempts    Int         @default(0)
  createdAt   DateTime    @default(now())
  sentAt      DateTime?
}
